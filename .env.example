# Скопируйте в .env и заполните. Файл .env никому не показывайте и не выкладывайте в git.

# --- Адрес магазина: ваш домен (HTTPS включится сам). Домен должен указывать на IP этой машины.
SITE_ADDRESS=shop.example.ru
# Тот же адрес с https:// - для sitemap и ссылок
PUBLIC_URL=https://shop.example.ru
# Только для проверки без домена: SITE_ADDRESS=:80 и COOKIE_SECURE=false (пароли пойдут без шифрования!)

# --- Название магазина по умолчанию (потом меняется в админке: «Настройки»)
SHOP_NAME=SOLEHOUSE

# --- Случайная строка от 32 символов: openssl rand -hex 32
SESSION_SECRET=

# --- База данных: ТА ЖЕ, что у приложения «Склад» (Яндекс Managed PostgreSQL).
# Пользователь - отдельный (shop_user), права ему выдаёт grants.sql
DB_HOST=c-xxxxxxxxxxxxxxxxxxxx.rw.mdb.yandexcloud.net
DB_PORT=6432
DB_NAME=
DB_USER=shop_user
DB_PASSWORD=
DB_SSL=verify
DB_SSL_CA=/certs/root.crt

# --- Первый владелец админки (создаётся при первом запуске, если админов ещё нет).
# После входа смените пароль и удалите эти две строки.
ADMIN_USER=owner
ADMIN_PASSWORD=

# --- Уведомления о новых заказах в Telegram (необязательно)
# 1) создайте бота у @BotFather и скопируйте токен; 2) добавьте бота в нужный чат (или напишите ему сами);
# 3) номер чата: откройте в браузере https://api.telegram.org/bot<ТОКЕН>/getUpdates после сообщения боту, там "chat":{"id":...}
#    (токен в адресе секретный, никому не показывайте). Несколько чатов - через запятую.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Расчёт доставки по API СДЭК (необязательно). Без него цены берутся из админки («Доставка и оплата»).
# Ключи: личный кабинет СДЭК -> Интеграция -> Ключи API (Account и Secure password). Для проверки без договора: CDEK_API_URL=https://api.edu.cdek.ru
# CDEK_ACCOUNT=
# CDEK_SECURE=
# Откуда отправляете: город (CDEK_FROM_CITY=Москва) или код города СДЭК (CDEK_FROM_CODE=44)
# CDEK_FROM_CITY=
# office - сами привозите посылки в пункт СДЭК (по умолчанию); door - курьер СДЭК забирает у вас
# CDEK_FROM_MODE=office
# Коробка с одной парой для расчёта тарифа (при нескольких парах вес и высота складываются)
# PARCEL_WEIGHT_G=1500
# PARCEL_LENGTH_CM=34
# PARCEL_WIDTH_CM=22
# PARCEL_HEIGHT_CM=14

# --- Карта онлайн через эквайринг ТБанка (необязательно). Без этих ключей способа «картой» на оформлении нет.
# Подключите интернет-эквайринг в ТБанк Бизнес: деньги приходят на расчётный счёт по договору эквайринга. Нужен PUBLIC_URL с https.
# TBANK_TERMINAL_KEY=
# TBANK_PASSWORD=
# Чек в платеже (если у терминала подключена касса): система налогообложения, например usn_income; пусто - без чека
# TBANK_TAXATION=
# Ставка НДС в чеке: none (без НДС), vat0, vat10, vat20
# TBANK_TAX=none

# --- Электроника партнёра (Sergeev Electronics). На боевом сервере включено само; выключить: PARTNER_SYNC=off
# PARTNER_SYNC=on
# Разделы партнёра через запятую (по умолчанию: техника Apple, Samsung, Dyson, Xiaomi, DJI, Garmin, GoPro и аксессуары)
# PARTNER_SECTIONS=tekhnika-apple,tekhnika-samsung,tekhnika-dyson,tekhnika-xiaomi,tekhnika-dji,garmin,tekhnika-gopro,aksessuary
# Пауза между запросами к сайту партнёра, мс (не уменьшайте без согласования с ними)
# PARTNER_DELAY_MS=3000

# --- Необязательно
# SESSION_HOURS=12            сколько часов действует вход в админку без активности
# DISPLAY_TZ=Europe/Moscow    часовой пояс для дат и статистики по дням
# CATALOG_TTL=30              как часто (сек) сайт перечитывает товары и остатки из базы склада
